# Copy to .env and change every value before opening port 7350 to the internet.
POSTGRES_PASSWORD=change_me_postgres
NAKAMA_CONSOLE_PASSWORD=change_me_console
NAKAMA_SERVER_KEY=bluffcards_dev_key
NAKAMA_SESSION_KEY=change_me_session
NAKAMA_REFRESH_KEY=change_me_refresh
NAKAMA_CONSOLE_SIGNING_KEY=change_me_signing
NAKAMA_HTTP_KEY=change_me_http

# Host ports (change when another Nakama already uses 7350 on this computer).
NAKAMA_PORT=7350
NAKAMA_CONSOLE_PORT=7351
